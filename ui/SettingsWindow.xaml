<UserControl x:Class="MystiaModManager.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold"/>
    <StackPanel Grid.Row="1" Margin="0,16,0,0">
      <TextBlock Text="游戏路径"/>
      <DockPanel Margin="0,4,0,12">
        <Button DockPanel.Dock="Right" Content="浏览" Margin="8,0,0,0" Padding="12,4" Click="BrowseGame_Click"/>
        <TextBox x:Name="GamePathBox" IsReadOnly="True"/>
      </DockPanel>
      <TextBlock Text="管理器安装路径"/>
      <DockPanel Margin="0,4,0,12">
        <Button DockPanel.Dock="Right" Content="浏览" Margin="8,0,0,0" Padding="12,4" Click="BrowseManager_Click"/>
        <TextBox x:Name="ManagerPathBox" IsReadOnly="True"/>
      </DockPanel>
      <TextBlock Text="配置父目录"/>
      <DockPanel Margin="0,4,0,0">
        <Button DockPanel.Dock="Right" Content="浏览" Margin="8,0,0,0" Padding="12,4" Click="BrowseConfig_Click"/>
        <TextBox x:Name="ConfigRootBox" IsReadOnly="True"/>
      </DockPanel>
    </StackPanel>
    <Button Grid.Row="2" Content="保存路径" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,12,0,0" Click="Save_Click"/>
  </Grid>
</UserControl>
