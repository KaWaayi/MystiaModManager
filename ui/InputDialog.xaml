<Window x:Class="MystiaModManager.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Height="180" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="PromptText" Margin="0,0,0,8"/>
    <TextBox x:Name="InputBox" Grid.Row="1"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <ui:Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0"/>
      <ui:Button Content="确定" Appearance="Primary" Click="Ok_Click"/>
    </StackPanel>
  </Grid>
</Window>
