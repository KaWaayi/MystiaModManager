<Window x:Class="MystiaModManager.SetupPathsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="确认路径"
        Height="360" Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
               Text="请确认游戏目录、管理器安装目录与配置父目录。后两者不可相同。"/>

    <Grid Grid.Row="1" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="100"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="游戏目录" VerticalAlignment="Center"/>
      <TextBox x:Name="GamePathBox" Grid.Column="1" Margin="8,0"/>
      <ui:Button Content="浏览" Grid.Column="2" Click="BrowseGame_Click"/>
    </Grid>

    <Grid Grid.Row="2" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="100"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="管理器目录" VerticalAlignment="Center"/>
      <TextBox x:Name="ManagerPathBox" Grid.Column="1" Margin="8,0"/>
      <ui:Button Content="浏览" Grid.Column="2" Click="BrowseManager_Click"/>
    </Grid>

    <Grid Grid.Row="3" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="100"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="配置目录" VerticalAlignment="Center"/>
      <TextBox x:Name="ConfigPathBox" Grid.Column="1" Margin="8,0"/>
      <ui:Button Content="浏览" Grid.Column="2" Click="BrowseConfig_Click"/>
    </Grid>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <ui:Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0"/>
      <ui:Button Content="确定" Appearance="Primary" Click="Ok_Click"/>
    </StackPanel>
  </Grid>
</Window>
